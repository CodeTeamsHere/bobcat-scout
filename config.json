{
  "title": "REBUILT 2026",
  "delimiter": "\t",
  "game": {
    "name": "REBUILT",
    "year": 2026,
    "note": "Fields mirror Team 177's REBUILT QRScout form. Keep the codes stable — the Sheet columns and the analytics engine key on them.",
    "display": {
      "autoCountCode": "autoFuel",
      "teleCountCode": "teleFuel",
      "defenseCode": "teleDefenseEff",
      "climbCode": "endClimbed",
      "climbLevels": [
        "level1",
        "level2",
        "level3"
      ]
    }
  },
  "sections": [
    {
      "name": "Prematch",
      "fields": [
        {
          "title": "Abbreviated Scouter Name",
          "type": "text",
          "code": "scoutName",
          "required": true,
          "preserve": true,
          "placeholder": "Your name"
        },
        {
          "title": "Event Key",
          "type": "text",
          "code": "eventKey",
          "required": true,
          "preserve": true,
          "placeholder": "2026ctwat",
          "help": "Set once per competition. The Sheet uses it to keep events apart."
        },
        {
          "title": "Match Number",
          "type": "number",
          "code": "matchNumber",
          "required": true,
          "default": 1,
          "min": 1,
          "max": 200,
          "placeholder": "Enter match number"
        },
        {
          "title": "Match Type",
          "type": "select",
          "code": "matchType",
          "default": "qm",
          "options": [
            {
              "k": "qm",
              "v": "Qualification"
            },
            {
              "k": "pm",
              "v": "Practice"
            },
            {
              "k": "sf",
              "v": "Playoff"
            }
          ]
        },
        {
          "title": "Team and Robot",
          "type": "number",
          "code": "teamNumber",
          "required": true,
          "default": 177,
          "min": 1,
          "max": 99999,
          "placeholder": "Enter team number"
        },
        {
          "title": "Starting Position",
          "type": "select",
          "code": "startingPosition",
          "required": true,
          "default": "",
          "help": "1, 2, 3 are red. 4, 5, 6 are blue. The alliance is worked out from this.",
          "options": [
            {
              "k": "",
              "v": "—"
            },
            {
              "k": "1",
              "v": "1 (Depot Side)"
            },
            {
              "k": "2",
              "v": "2"
            },
            {
              "k": "3",
              "v": "3 (Outpost Side)"
            },
            {
              "k": "4",
              "v": "4 (Outpost Side)"
            },
            {
              "k": "5",
              "v": "5"
            },
            {
              "k": "6",
              "v": "6 (Depot Side)"
            }
          ]
        },
        {
          "title": "Alliance",
          "type": "select",
          "code": "alliance",
          "hidden": true,
          "preserve": true,
          "default": "",
          "options": [
            {
              "k": "",
              "v": "—"
            },
            {
              "k": "red",
              "v": "Red"
            },
            {
              "k": "blue",
              "v": "Blue"
            }
          ]
        },
        {
          "title": "No Show",
          "type": "boolean",
          "code": "noShow",
          "fail": true
        }
